# Copy this file to .env.local and fill in real values.
# .env.local is gitignored by default in Next.js projects.
#
# For Vercel deployment: set these as Environment Variables in the
# Vercel project settings (Settings → Environment Variables).

# Supabase — required for all environments
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Supabase service role — only needed server-side (admin actions).
# NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Admin panel — set to "1" to enable /admin routes in production.
# Leave unset or empty to hide admin with a 404.
ADMIN_ENABLED=

# Anthropic — only used by the ingest pipeline (apps/ingest),
# not needed for the web app at runtime.
# ANTHROPIC_API_KEY=sk-ant-...
